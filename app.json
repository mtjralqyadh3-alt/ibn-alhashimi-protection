{
  "expo": {
    "owner": "wkxkx",
    "name": "حماية ابن الهاشمي",
    "slug": "ibn-alhashimi-protection",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a84ff"
    },
    "android": {
      "package": "com.mtjralqyadh.ibnalhashimi.protection",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/foreground.png",
        "backgroundColor": "#0a84ff"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_CONTACTS",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "QUERY_ALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "للفحص الحقيقي للصور المكررة بموافقتك فقط",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "لفحص الأرقام المكررة على جهازك فقط"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0a84ff"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "لفتح الخزنة المشفرة"
        }
      ]
    ]
  }
}
